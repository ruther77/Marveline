{
  "name": "carocorp-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "lint:errors": "eslint . --ext ts,tsx --report-unused-disable-directives --quiet",
    "lint:warnings:budget": "node ./scripts/check-lint-warning-budget.mjs",
    "lint:strict": "npm run lint:errors && npm run lint:warnings:budget",
    "check:api-access": "node ./scripts/check-api-access.mjs",
    "check:critical-contracts": "node ./scripts/check-critical-contracts.mjs",
    "report:endpoint-coverage": "node ./scripts/report-endpoint-coverage.mjs --json",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "generate:api": "openapi-typescript http://localhost:8000/openapi.json -o src/api/generated/schema.ts",
    "generate:api:file": "openapi-typescript ./openapi.json -o src/api/generated/schema.ts"
  },
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "^2.0.2",
    "@hookform/resolvers": "^3.3.0",
    "@radix-ui/react-select": "^2.1.3",
    "@tanstack/react-query": "^5.8.0",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-router": "^1.161.3",
    "@types/react-signature-canvas": "^1.0.7",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "lucide-react": "^0.294.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.0",
    "react-hot-toast": "^2.6.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^3.6.0",
    "tailwind-merge": "^2.1.0",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0",
    "zod": "^3.22.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/router-devtools": "^1.161.3",
    "@tanstack/router-vite-plugin": "^1.161.3",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@vitest/ui": "^2.0.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "jsdom": "^23.0.0",
    "msw": "^2.0.0",
    "openapi-typescript": "^7.10.1",
    "otpauth": "^9.5.0",
    "otplib": "^13.3.0",
    "postcss": "^8.4.31",
    "speakeasy": "^2.0.0",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.9.3",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
