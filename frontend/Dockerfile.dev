# Dockerfile.dev — Frontend Development avec Hot Reload
FROM node:20-alpine

WORKDIR /app

# Copier package files et installer dépendances
COPY package*.json ./
RUN npm ci

# Le code source sera monté via volume
# Pas de COPY . . pour permettre hot reload

# Exposer port Vite dev server
EXPOSE 5173

# Commande sera overridée par docker-compose.dev.yml
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
