# ===================================================
# Marveline — Configuration
# Copier en .env et remplacer les valeurs CHANGER_*
# ===================================================

# Application
ENV=dev
DEBUG=true
APP_NAME=Marveline
APP_VERSION=1.0.0
LOG_LEVEL=INFO
GZIP_MIN_SIZE=500

# Database
DATABASE_URL=postgresql+psycopg2://marveline:dev_password@localhost:5434/marveline
POSTGRES_DB=marveline
POSTGRES_USER=marveline
POSTGRES_PASSWORD=CHANGER_MOT_DE_PASSE_POSTGRES
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Security — password hashing
PASSWORD_PEPPER=CHANGER_PEPPER_MIN_32_CARACTERES_OBLIGATOIRE
BCRYPT_ROUNDS=12
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# MFA envelope encryption (spec S05-MFA-TOTP S5.4 — NC-07)
# Prod : utiliser une valeur aleatoire >= 32 chars (ou ARN AWS KMS)
ENCRYPTION_KEY=CHANGER_CLE_ENCRYPTION_32_BYTES_OBLIGATOIRE
TOTP_DEV_MASTER_KEY=CHANGER_TOTP_MASTER_KEY_MIN_32_CHARS_OBLIGATOIRE

# HMAC signing des audit logs (spec S01 S1.8)
# Prod : valeur aleatoire >= 32 chars (ou ARN AWS Secrets Manager versionne)
AUDIT_HMAC_KEY=CHANGER_AUDIT_HMAC_KEY_MIN_32_CHARS_OBLIGATOIRE

# JWT RS256 — 2 paires de cles separees access/refresh (CaroCorp S1.1)
JWT_ALGORITHM=RS256
JWT_ACCESS_PRIVATE_KEY_PATH=keys/jwt_access_private.pem
JWT_ACCESS_PUBLIC_KEY_PATH=keys/jwt_access_public.pem
JWT_REFRESH_PRIVATE_KEY_PATH=keys/jwt_refresh_private.pem
JWT_REFRESH_PUBLIC_KEY_PATH=keys/jwt_refresh_public.pem
JWT_ISSUER=marveline.com
JWT_AUDIENCE=marveline-api
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=604800
JWT_CLOCK_SKEW_SECONDS=30
# KMS (prod only — dev utilise les fichiers PEM locaux)
KMS_KEY_ACCESS=
KMS_KEY_REFRESH=

# Redis dual (CaroCorp S3.1-3.2)
# redis-sec : auth/tokens/sessions (noeviction, AOF)
# redis-cache : cache applicatif + Celery (allkeys-lru)
REDIS_SEC_PASSWORD=CHANGER_MOT_DE_PASSE_REDIS_SEC
REDIS_CACHE_PASSWORD=CHANGER_MOT_DE_PASSE_REDIS_CACHE
REDIS_SEC_URL=redis://:CHANGER_MOT_DE_PASSE_REDIS_SEC@localhost:6382/0
REDIS_CACHE_URL=redis://:CHANGER_MOT_DE_PASSE_REDIS_CACHE@localhost:6383/0

# Celery (sur redis-cache)
CELERY_BROKER_URL=redis://:CHANGER_MOT_DE_PASSE_REDIS_CACHE@localhost:6383/1
CELERY_RESULT_BACKEND=redis://:CHANGER_MOT_DE_PASSE_REDIS_CACHE@localhost:6383/2

# CORS — origins autorisées (JSON array)
# Mobile LAN : ajouter l'IP locale du serveur vue par le téléphone
# Ex: CORS_ORIGINS=["http://localhost:3002","http://192.168.1.10:3002"]
CORS_ORIGINS=["http://localhost:3002"]
CORS_ALLOW_CREDENTIALS=true

# Trusted hosts — noms d'hôtes acceptés par le serveur (JSON array)
# Mobile LAN : ajouter l'IP locale (sans port, sans scheme)
# Ex: ALLOWED_HOSTS=["localhost","127.0.0.1","api","testserver","192.168.1.10"]
# Wildcard supporté : "*.marveline.com" pour tous les sous-domaines
ALLOWED_HOSTS=["localhost","127.0.0.1","api","testserver"]

# Proxy de confiance (nginx/traefik) — activer pour utiliser X-Forwarded-For
# DESACTIVE par defaut : sans proxy configure, X-Forwarded-For
# est controlable par le client = bypass rate limit possible.
TRUSTED_PROXY_HEADERS=false

# Email / SMTP (Mailpit en dev : SMTP_HOST=mailpit, SMTP_PORT=1025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@marveline.com

# Frontend URL (pour les liens dans les emails)
FRONTEND_URL=http://localhost:3002

# Frontend Vite (injecté au build Docker frontend)
VITE_API_URL=/api/v1
VITE_MASSACORP_AUTH_TENANT_ID=2
VITE_MASSACORP_EPICERIE_TENANT_ID=2
VITE_MASSACORP_RESTAURANT_TENANT_ID=2

# hCaptcha (CaroCorp S7.2 NIVEAU 4)
# Dev : laisser vide (skip API verification)
# Prod : vrais credentials hcaptcha.com
HCAPTCHA_SECRET_KEY=
HCAPTCHA_VERIFY_URL=https://hcaptcha.com/siteverify

# OAuth Google (laisser vide pour desactiver)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:3002/auth/callback/google

# OAuth GitHub (laisser vide pour desactiver)
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=http://localhost:3002/auth/callback/github

# OAuth Facebook (laisser vide pour desactiver)
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_FACEBOOK_REDIRECT_URI=http://localhost:3002/auth/callback/facebook

# Sentry APM (laisser vide pour desactiver en dev)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Uploads
UPLOAD_DIR=/uploads

# WireGuard (WG_BACKEND=mock en dev — pas de vrai tunnel)
WG_INTERNAL_API_KEY=CHANGER_WG_API_KEY_EN_PROD
WG_ENCRYPTION_KEY=CHANGER_WG_ENCRYPTION_KEY_32_BYTES
WG_BACKEND=mock
WG_PRIVATE_KEY=
WG_LISTEN_PORT=51820
WG_ADDRESS=10.10.0.1/24
WG_ENDPOINT=vpn.marveline.com
WG_DNS=1.1.1.1,8.8.8.8
WG_LOG_LEVEL=INFO

# Boxtal — devis transporteurs (ex EnvoiMoinsCher)
# Dev : laisser vide (fallback saisie manuelle)
# Test : creer un compte gratuit sur https://test.envoimoinscher.com
# Prod : creer un compte sur https://www.envoimoinscher.com
BOXTAL_LOGIN=
BOXTAL_PASSWORD=
BOXTAL_ENV=test

# Flower — monitoring Celery (dev uniquement)
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGER_MOT_DE_PASSE_FLOWER

# Ngrok tunnel — expose le reverse proxy en HTTPS public
# Usage : make ngrok-up  (profil "tunnel")
# Compte gratuit : https://dashboard.ngrok.com > Your Authtoken
NGROK_AUTHTOKEN=CHANGER_TOKEN_NGROK
# Domaine statique ngrok (plans payants) — laisser vide pour URL aléatoire
# Ex: NGROK_DOMAIN=mon-projet.ngrok.io
NGROK_DOMAIN=
# CORS — ajouter l'URL ngrok quand tunnel actif :
#   CORS_ORIGINS=["http://localhost:3002","https://mon-projet.ngrok.io"]
#   ALLOWED_HOSTS=["localhost","127.0.0.1","api","testserver","mon-projet.ngrok.io"]
