# Configuration CaroCorp - Development

# Application
ENV=dev
DEBUG=true
APP_NAME=CaroCorp
APP_VERSION=0.1.0

# Database
DATABASE_URL=postgresql+psycopg2://caro:dev_password@localhost:5433/CaroCorp
POSTGRES_DB=CaroCorp
POSTGRES_USER=caro
POSTGRES_PASSWORD=CHANGER_MOT_DE_PASSE_POSTGRES
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Security
JWT_SECRET=CHANGER_CLE_JWT_MIN_32_CARACTERES
CSRF_SECRET=CHANGER_CLE_CSRF_MIN_32_CARACTERES
BCRYPT_ROUNDS=12

# Redis
REDIS_PASSWORD=CHANGER_MOT_DE_PASSE_REDIS
REDIS_URL=redis://:CHANGER_MOT_DE_PASSE_REDIS@localhost:6380/0
SESSION_EXPIRE_SECONDS=3600

# Celery
CELERY_BROKER_URL=redis://:CHANGER_MOT_DE_PASSE_REDIS@localhost:6380/1
CELERY_RESULT_BACKEND=redis://:CHANGER_MOT_DE_PASSE_REDIS@localhost:6380/2

# CORS
CORS_ORIGINS=["http://localhost:3002"]
CORS_ALLOW_CREDENTIALS=true
