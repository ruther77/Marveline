# Configuration CaroCorp - Development

# Database
DATABASE_URL=postgresql+psycopg2://caro:password@localhost:5433/CaroCorp
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Security
JWT_SECRET=dev_jwt_secret_CHANGER_EN_PRODUCTION_min32chars
CSRF_SECRET=dev_csrf_secret_CHANGER_EN_PRODUCTION_min32chars
BCRYPT_ROUNDS=12

# Redis
REDIS_URL=redis://:password@localhost:6380/0
SESSION_EXPIRE_SECONDS=3600

# Celery
CELERY_BROKER_URL=redis://:password@localhost:6380/1
CELERY_RESULT_BACKEND=redis://:password@localhost:6380/2

# CORS
CORS_ORIGINS=["http://localhost:3002"]
CORS_ALLOW_CREDENTIALS=true

# App
DEBUG=true
APP_NAME=CaroCorp
APP_VERSION=0.1.0
