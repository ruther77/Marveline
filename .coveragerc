[run]
omit =
    */tests/*
    */migrations/*
    app/tasks/celery_app.py
    app/constants/_template_domaine.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
